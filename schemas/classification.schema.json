{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TranscriptClassification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_type",
    "confidence",
    "reason"
  ],
  "properties": {
    "content_type": {
      "type": "string",
      "enum": [
        "generic",
        "meeting",
        "webinar",
        "youtube_video",
        "non rilevato"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": "string"
    }
  }
}
