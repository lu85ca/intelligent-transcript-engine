{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TranscriptClassification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "subtype",
    "confidence",
    "secondary_type",
    "selected_recipe",
    "selected_domain_profile",
    "signals",
    "reason"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "generic",
        "meeting",
        "webinar",
        "youtube_video",
        "non rilevato"
      ]
    },
    "subtype": {
      "type": "string",
      "enum": [
        "generic_meeting",
        "technical_flow_meeting",
        "non rilevato"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "secondary_type": {
      "type": "string",
      "enum": [
        "generic",
        "meeting",
        "webinar",
        "youtube_video",
        "non rilevato"
      ]
    },
    "selected_recipe": {
      "type": "string",
      "enum": [
        "recipes/generic.md",
        "recipes/meeting.md",
        "recipes/technical_flow_meeting.md",
        "recipes/webinar.md",
        "recipes/youtube_video.md",
        "non rilevato"
      ]
    },
    "selected_domain_profile": {
      "type": "string",
      "enum": [
        "domain_profiles/sige_imu_document_flow.md",
        "non rilevato"
      ]
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string"
    }
  }
}
