{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GenericTranscriptAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "facts",
    "interpretations",
    "decisions",
    "actions",
    "open_questions"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interpretations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "owner",
          "due_date"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "due_date": {
            "type": "string"
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
